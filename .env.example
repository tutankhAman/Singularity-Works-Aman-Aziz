# ── Core APIs ──────────────────────────────────────────────
DEEPGRAM_API_KEY=           # Deepgram live streaming + batch transcription
GEMINI_API_KEY=             # Gemini 2.0 (Tier 4, Embeddings)
SAMBANOVA_API_KEY=          # SambaNova (Tier 2 fast intent categorization)
# Optional override (default Meta-Llama-3.1-70B-Instruct)
# SAMBANOVA_TIER2_MODEL=
RESEND_API_KEY=             # Resend email dispatch
REPORT_EMAIL_FROM=noreply@lucid.app

# ── Auth (Better Auth) ─────────────────────────────────────
BETTER_AUTH_SECRET=supersecret32bytehexstringhere
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Database (Users & Sessions only) ──────────────────────
DATABASE_URL=postgresql://lucid:lucid@localhost:5432/lucid

# ── Infrastructure ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379
AWS_ACCESS_KEY_ID=          # S3 audio persistence
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=lucid-audio-sessions

# ── Tuning ─────────────────────────────────────────────────
PORT=3001
WORKERS_PORT=8080
GEMINI_TIER2_TIMEOUT_MS=5000
GEMINI_TIER4_TIMEOUT_MS=1500
MAX_CONNECTIONS=50
